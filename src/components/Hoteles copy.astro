<style>
    .particula-dorada {
        position: absolute;
        width: 4px;
        height: 4px;
        background: #9c7a2e;
        border-radius: 50%;
        opacity: 0.3;
        animation: flotar 6s ease-in-out infinite;
    }
    @keyframes flotar {
        0%,
        100% {
            transform: translateY(0) scale(1);
            opacity: 0.3;
        }
        50% {
            transform: translateY(-20px) scale(1.2);
            opacity: 0.6;
        }
    }
    .animate-pulse-slow {
        animation: pulse 4s ease-in-out infinite;
    }
    @keyframes pulse {
        0%,
        100% {
            opacity: 0.3;
        }
        50% {
            opacity: 0.6;
        }
    }
    .verde-filter {
        filter: brightness(0) saturate(100%) invert(20%) sepia(40%)
            saturate(500%) hue-rotate(120deg) brightness(80%) contrast(90%);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initHoteles = () => {
        gsap.set("#contenedor-hoteles", { opacity: 0, y: 30 });
        gsap.set("#flor-hoteles-left", { opacity: 0, x: -40 });
        gsap.set("#flor-hoteles-right", { opacity: 0, x: 40 });
        gsap.set("#hoja-hoteles-left", { opacity: 0, x: -50 });
        gsap.set("#hoja-hoteles-right", { opacity: 0, x: 50 });
        gsap.set(".hotel-card", { opacity: 0, y: 20 });

        ScrollTrigger.create({
            trigger: "#contenedor-hoteles",
            start: "top 80%",
            end: "top 20%",

            onEnter: () => {
                const tl = gsap.timeline();

                tl.to(
                    "#contenedor-hoteles",
                    { opacity: 1, y: 0, duration: 1.2, ease: "power3.out" },
                    0,
                )
                    .to(
                        ".hotel-card",
                        {
                            opacity: 1,
                            y: 0,
                            duration: 0.8,
                            stagger: 0.12,
                            ease: "power2.out",
                        },
                        0.4,
                    )
                    .to(
                        "#flor-hoteles-left",
                        {
                            opacity: 0.75,
                            x: 0,
                            duration: 1,
                            ease: "power2.out",
                        },
                        0.5,
                    )
                    .to(
                        "#flor-hoteles-right",
                        {
                            opacity: 0.75,
                            x: 0,
                            duration: 1,
                            ease: "power2.out",
                        },
                        0.5,
                    )
                    .to(
                        "#hoja-hoteles-left",
                        {
                            opacity: 0.7,
                            x: 0,
                            duration: 1.2,
                            ease: "power2.out",
                        },
                        0.7,
                    )
                    .to(
                        "#hoja-hoteles-right",
                        {
                            opacity: 0.7,
                            x: 0,
                            duration: 1.2,
                            ease: "power2.out",
                        },
                        0.7,
                    );
            },

            onLeaveBack: () => {
                gsap.to("#contenedor-hoteles", {
                    opacity: 0,
                    y: 30,
                    duration: 0.5,
                    ease: "power2.in",
                });
                gsap.to(".hotel-card", {
                    opacity: 0,
                    y: 20,
                    duration: 0.4,
                    ease: "power2.in",
                });
                gsap.to("#flor-hoteles-left", {
                    opacity: 0,
                    x: -40,
                    duration: 0.5,
                });
                gsap.to("#flor-hoteles-right", {
                    opacity: 0,
                    x: 40,
                    duration: 0.5,
                });
                gsap.to("#hoja-hoteles-left", {
                    opacity: 0,
                    x: -50,
                    duration: 0.5,
                });
                gsap.to("#hoja-hoteles-right", {
                    opacity: 0,
                    x: 50,
                    duration: 0.5,
                });
            },
        });
    };

    document.addEventListener("DOMContentLoaded", initHoteles);
    document.addEventListener("astro:page-load", initHoteles);
</script>
