    />

    <div class="max-w-xl mx-auto relative z-10" id="wrapper-hoteles">
        <!-- Título -->
        <div class="text-center mb-10 opacity-0" id="hoteles-titulo">
            <h3
                class="text-[#9C7A2E] tracking-[0.25em] uppercase text-xl md:text-2xl font-semibold mb-3"
            >
                Hospedaje
            </h3>
            <div class="flex items-center justify-center gap-3 mb-5">
                <div
                    class="w-14 h-[1px] bg-gradient-to-r from-transparent to-[#C9A961]"
                >
                </div>
                <div class="w-2 h-2 rounded-full bg-[#C9A961]"></div>
                <div
                    class="w-14 h-[1px] bg-gradient-to-l from-transparent to-[#C9A961]"
                >
                </div>
            </div>
            <!-- Icono hotel -->
            <div class="flex justify-center mb-4">
                <img
                    src="/iconos/hoteles.png"
                    alt="Hotel"
                    class="w-14 h-14 md:w-16 md:h-16 object-contain hotel-icon-filter"
                />
            </div>
            <p
                class="font-charm text-[#626a54] text-lg md:text-xl leading-relaxed"
            >
                Para nuestros invitados que vienen de fuera, hemos seleccionado
                algunas opciones de hospedaje en Camargo para su comodidad. Les
                recomendamos realizar su reserva con anticipación.
            </p>
        </div>

        <!-- Grid de tarjetas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Hotel 1 -->
            <div
                class="hotel-card opacity-0 bg-white/80 rounded-2xl shadow-sm overflow-hidden flex flex-col items-center text-center pt-0 pb-7 px-6"
