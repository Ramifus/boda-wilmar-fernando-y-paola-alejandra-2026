<style>
    .hotel-icon-filter {
        filter: brightness(0) saturate(100%) invert(56%) sepia(77%)
            saturate(419%) hue-rotate(5deg) brightness(94%) contrast(92%);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initHoteles = () => {
        // Estado inicial — izquierda normal, derecha volteada con scaleX:-1 desde GSAP
        gsap.set("#hoteles-titulo", { opacity: 0, y: 25 });
        gsap.set(".hotel-card", { opacity: 0, y: 30, scale: 0.97 });
        gsap.set("#mano-h1, #mano-h2, #mano-h3, #mano-h4, #mano-h5", {
            opacity: 0,
            scale: 0.8,
        });

        gsap.set("#flor-hot-izq", {
            opacity: 0,
            x: -20,
            scaleX: 1,
            scaleY: 1,
            rotation: 0,
            y: 0,
        });
        gsap.set("#hoja-hot-izq", {
            opacity: 0,
            x: -20,
            scaleX: 1,
            scaleY: 1,
            rotation: 0,
            y: 0,
        });
        gsap.set("#flor-hot-der", {
            opacity: 0,
            x: 20,
            scaleX: -1,
            scaleY: 1,
            rotation: 0,
            y: 0,
        });
        gsap.set("#hoja-hot-der", {
            opacity: 0,
            x: 20,
            scaleX: -1,
            scaleY: 1,
            rotation: 0,
            y: 0,
        });

        ScrollTrigger.create({
            trigger: "#wrapper-hoteles",
            start: "top 80%",
            end: "top 20%",

            onEnter: () => {
                const tl = gsap.timeline();

                tl.to(
                    "#hoteles-titulo",
                    { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
                    0,
                )
                    .to(
                        ".hotel-card",
                        {
                            opacity: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.8,
                            stagger: 0.15,
                            ease: "power2.out",
                        },
                        0.4,
                    )
                    .to(
                        "#mano-h1, #mano-h2, #mano-h3, #mano-h4, #mano-h5",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.4,
                            stagger: 0.15,
                            ease: "back.out(2)",
                        },
                        0.9,
                    )
                    .to(
                        "#flor-hot-izq",
                        { opacity: 0.8, x: 0, duration: 1, ease: "power2.out" },
                        0.5,
                    )
                    .to(
                        "#flor-hot-der",
                        { opacity: 0.8, x: 0, duration: 1, ease: "power2.out" },
                        0.5,
                    )
                    .to(
                        "#hoja-hot-izq",
                        {
                            opacity: 0.9,
                            x: 0,
                            duration: 1.2,
                            ease: "power2.out",
                        },
                        1.5,
                    )
                    .to(
                        "#hoja-hot-der",
                        {
                            opacity: 0.9,
                            x: 0,
                            duration: 1.2,
                            ease: "power2.out",
                        },
                        1.5,
                    );

                // Mano pulsando
                gsap.to("#mano-h1, #mano-h2, #mano-h3, #mano-h4, #mano-h5", {
                    scale: 0.88,
                    duration: 0.6,
                    ease: "power1.inOut",
                    repeat: -1,
                    yoyo: true,
                    delay: 1.5,
                });

                // Movimiento natural — solo Y para las flores, sin rotation en las de la derecha
                gsap.to("#flor-hot-izq", {
                    y: -10,
                    rotation: -8,
                    duration: 3.5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 2.5,
                });
                gsap.to("#hoja-hot-izq", {
                    y: -12,
                    rotation: -10,
                    duration: 4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 2.8,
                });
                gsap.to("#flor-hot-der", {
                    y: -10,
                    duration: 3.8,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 2.7,
                });
                gsap.to("#hoja-hot-der", {
                    y: -12,
                    duration: 4.3,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3,
                });
            },

            onLeaveBack: () => {
                gsap.killTweensOf(
                    "#mano-h1, #mano-h2, #mano-h3, #mano-h4, #mano-h5",
                );
                gsap.killTweensOf("#flor-hot-izq");
                gsap.killTweensOf("#flor-hot-der");
                gsap.killTweensOf("#hoja-hot-izq");
                gsap.killTweensOf("#hoja-hot-der");

                // Reset completo incluyendo rotation y y, para evitar acumulación
                gsap.set("#flor-hot-izq", {
                    opacity: 0,
                    x: -20,
                    scaleX: 1,
                    scaleY: 1,
                    rotation: 0,
                    y: 0,
                });
                gsap.set("#hoja-hot-izq", {
                    opacity: 0,
                    x: -20,
                    scaleX: 1,
                    scaleY: 1,
                    rotation: 0,
                    y: 0,
                });
                gsap.set("#flor-hot-der", {
                    opacity: 0,
                    x: 20,
                    scaleX: -1,
                    scaleY: 1,
                    rotation: 0,
                    y: 0,
                });
                gsap.set("#hoja-hot-der", {
                    opacity: 0,
                    x: 20,
                    scaleX: -1,
                    scaleY: 1,
                    rotation: 0,
                    y: 0,
                });

                gsap.to("#hoteles-titulo", {
                    opacity: 0,
                    y: 25,
                    duration: 0.4,
                    ease: "power2.in",
                });
                gsap.to(".hotel-card", {
                    opacity: 0,
                    y: 30,
                    scale: 0.97,
                    duration: 0.4,
                    ease: "power2.in",
                });
                gsap.to("#mano-h1, #mano-h2, #mano-h3, #mano-h4, #mano-h5", {
                    opacity: 0,
                    scale: 0.8,
                    duration: 0.3,
                });
            },
        });
    };

    document.addEventListener("DOMContentLoaded", initHoteles);
    document.addEventListener("astro:page-load", initHoteles);
</script>
