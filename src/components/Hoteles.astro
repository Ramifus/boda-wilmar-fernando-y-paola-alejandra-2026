<section class="relative w-full py-14 px-6 overflow-hidden">
    <!-- Flores decorativas — sin scale-x en HTML, todo controlado por GSAP -->
    <img
        src="/imagenes/hojadorada.png"
        alt=""
        class="absolute left-0 top-16 w-18 md:w-24 opacity-0 pointer-events-none z-10"
        id="hoja-hot-izq"
    />
    <img
        src="/imagenes/florlateral.png"
        alt=""
        class="absolute left-0 top-20 w-18 md:w-24 opacity-0 pointer-events-none z-[11]"
        id="flor-hot-izq"
